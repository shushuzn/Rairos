{
  // VS Code settings for Rairos
  // .vscode/settings.json

  // Rust settings
  "rust.all-targets": false,
  "rust.analyzer-targets": "allTargets",
  "rust.analyzer-server.extraEnv": {
    "CARGO_BUILD_JOBS": "1"
  },

  // Don't run analysis on save for large projects
  "rust-analyzer.checkOnSave.onlyArg": "--no-default-features",
  "rust-analyzer.cargo.buildScripts.enable": true,

  // Files
  "files.exclude": {
    "**/.git": true,
    "**/target": true,
    "**/.codegraph": true
  },

  // Format on save
  "editor.formatOnSave": true,
  "editor.rulers": [100],

  // Terminal
  "terminal.integrated.env.linux": {
    "CARGO_BUILD_JOBS": "1"
  },

  // Search
  "search.exclude": {
    "**/target": true,
    "**/.codegraph": true
  }
}
