# Rairos environment variables
# Copy to .env and fill in values

# =======================
# Required for some features
# =======================

# GitHub API token (optional, for higher rate limits)
# Get at: https://github.com/settings/tokens
# GITHUB_TOKEN=

# =======================
# Optional overrides
# =======================

# Rairos database path (default: ~/.ai_research_os/rairos.db)
# RAIROS_DB=/path/to/database.db

# =======================
# LLM Configuration
# =======================

# OpenAI API key (for LLM-backed features)
# OPENAI_API_KEY=

# OpenAI base URL (default: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default LLM model (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# =======================
# Ollama (local LLM)
# =======================

# Ollama base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama embedding model (default: nomic-embed-text)
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =======================
# Build settings
# =======================

# Use 'make build' for optimized builds (parallel + mold + ccache)
# For memory-constrained builds:
# unset RUSTC_WRAPPER && CARGO_BUILD_JOBS=1 cargo build
