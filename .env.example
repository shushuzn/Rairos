# ai_research_os — environment variables
# Copy this file to .env and fill in values.
# All settings are optional; defaults match the historical hardcoded values.

# ── Internationalization ───────────────────────────────────────────────────────
# Language preference: "zh" (Chinese) or "en" (English)
# AI_RESEARCH_LANG=zh

# ── Observability ────────────────────────────────────────────────────────────
# Override the trace ID for distributed tracing
# RAIROS_TRACE_ID=

# ── Embedding ────────────────────────────────────────────────────────────────
# Embedding vector dimension (nomic-embed-text uses 768)
# AIROS_EMBEDDING_DIM=768

# ── Zilliz Cloud (optional) ─────────────────────────────────────────────────
# Get credentials from https://cloud.zilliz.com
# ZILLIZ_URI=https://xxx.zillizcloud.com:443
# ZILLIZ_TOKEN=your_api_key

# ── HTTP cache ───────────────────────────────────────────────────────────────
# How long cached arXiv / Crossref API responses live, in seconds
# AIROS_CACHE_TTL_SECONDS=86400

# ── LLM Response Cache ───────────────────────────────────────────────────────
# How long LLM responses are cached, in seconds (default: 7 days)
# Set to lower values for testing, higher for production
# AIROS_CACHE_TTL_SECONDS=604800

# ── LLM cost table ───────────────────────────────────────────────────────────
# Override or extend the built-in token-price table.
# Format: model_prefix:input_per_1M:output_per_1M, comma-separated.
# Unrecognised models fall back to the "default" entry (1.0, 4.0).
# Example (adds a new entry):
# AIROS_MODEL_PRICES=my-model:0.5:2.0
#
# The built-in table includes: gpt-4o, gpt-4o-mini, gpt-4-turbo,
# gpt-3.5-turbo, o1-preview, o1-mini, qwen3.5-plus, qwen3.5, qwen2.5,
# deepseek-chat, claude-3-5-sonnet, claude-3-5-haiku

# ── Default LLM models ───────────────────────────────────────────────────────
# AIROS_DEFAULT_MODEL_CLI=qwen3.5-plus      # used by cli.py
# AIROS_DEFAULT_MODEL_RESEARCH=gpt-4o-mini  # used by research_loop/__init__.py

# ── LLM API Keys ────────────────────────────────────────────────────────────
# Option 1: OpenAI-compatible API (default, supports DeepSeek, Groq, local models, etc.)
# OPENAI_API_KEY=sk-xxxxx
# LLM_BASE_URL=https://api.openai.com/v1   # optional, for proxies/custom endpoints

# Option 2: Anthropic Claude API (auto-detected when model name contains "claude")
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# Example models that use Anthropic API:
#   claude-3-5-sonnet-latest, claude-3-opus-latest, claude-3-haiku-latest

# Option 3: Ollama (local, free, no API key needed)
# Just prefix model name with "ollama/" (e.g. ollama/qwen2.5, ollama/llama3.2)
# Start Ollama: ollama serve
# Pull a model: ollama pull qwen2.5
AIROS_OLLAMA_BASE_URL=http://localhost:11434
AIROS_DEFAULT_OLLAMA_MODEL=qwen2.5

# ── Jin10 Financial Data MCP ──────────────────────────────────────────────────
# Get token from Jin10 service
# JIN10_MCP_URL=https://mcp.jin10.com/mcp
# JIN10_MCP_TOKEN=sk-xxxxx

# ── Author-parsing cache ─────────────────────────────────────────────────────
# Maxsize for the LRU cache that deduplicates JSON-author parsing
# AIROS_PARSE_AUTHORS_CACHE_SIZE=4096

# Logging
# RAIROS_JSON_LOGS=1          # Enable structured JSON logs
# RAIROS_LOG_LEVEL=INFO        # Log level (DEBUG, INFO, WARNING, ERROR)

# ── Directory & Concurrency ──────────────────────────────────────────────────
# AIROS_CACHE_DIR=~/.ai_research_os/data        # Paper cache directory
# AIROS_OUTPUT_DIR=output/surveys                # Survey/report output directory
# AIROS_CONCURRENT_WORKERS=8                    # Max parallel workers for batch operations
# AIROS_MEMORY_CACHE_MAX_SIZE=1000              # LRU cache size for parsed papers

# ── LLM Routing & Cost ──────────────────────────────────────────────────────
# AIROS_DEFAULT_MODEL_MINIMAX=minimax-m2.7-highspeed  # Default Minimax model
# AIROS_DEFAULT_OPENAI_BASE_URL=https://api.openai.com/v1
# AIROS_LLM_TIMEOUT=180                          # LLM request timeout (seconds)
# AIROS_ROUTER_COST_SENSITIVE=0                  # Enable cost-aware routing (0 or 1)

# ── Search & Tagging ───────────────────────────────────────────────────────
# AIROS_MAX_TAGS=5                                # Max tags per paper
# AIROS_MAX_CACHE_FILES=2000                      # Max files in disk cache
# AIROS_RESEARCH_LOOP_DEFAULT_LIMIT=5             # Default paper limit for deep research
# AIROS_RESEARCH_LOOP_DEFAULT_OUTPUT_DIR=         # Default output dir for research loop

# ── PDF Processing ─────────────────────────────────────────────────────────
# AIROS_PDF_MAX_PAGES=100                        # Max PDF pages to process
# AIROS_PDF_OCR_LANG=chi_sim+eng                 # Tesseract OCR languages
# AIROS_PDF_OCR_ZOOM=2.0                         # OCR image zoom factor
