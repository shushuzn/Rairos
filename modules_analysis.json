      "path": "scoring/",
      "files": {
        "momentum.py": {
          "description": "Research momentum / paper importance scoring",
          "classes": [
            {
              "name": "ResearchMomentum",
              "type": "Class",
              "methods": ["score_paper", "score_tag", "get_top_papers", "get_tag_leaderboard", "refresh_all"],
              "formula": {
                "citation_score": "30% — log scale, max 100",
