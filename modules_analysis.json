          "description": "Cosine similarity ranking strategy — numpy-accelerated",
          "classes": [
            {
              "name": "CosineSimilarityRanker",
              "type": "Ranker",
              "implementation": "Uses numpy for batch vector operations",
              "features": ["O(n) vectorized similarity computation", "Configurable threshold (default 0.85)", "Single SQL query for embeddings"]
            }
          ]
        },
        "score.py": {
          "description": "Composite scoring combining semantic similarity + paper metadata",
          "classes": [
            {
              "name": "CompositeScorer",
              "type": "Ranker",
              "weights": {
                "sim_weight": 0.7,
                "recency_weight": 0.2,
                "parse_weight": 0.1
              },
              "components": ["cosine similarity", "recency bonus", "parse quality bonus"]
            }
          ]
        }
      }
