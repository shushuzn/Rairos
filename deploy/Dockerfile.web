FROM rust:1.75 as builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates/rairos-web ./crates/rairos-web
COPY crates/rairos-core ./crates/rairos-core
COPY crates/rairos-observability ./crates/rairos-observability
COPY crates/rairos-llm ./crates/rairos-llm
COPY crates/rairos-kg ./crates/rairos-kg
COPY crates/rairos-research ./crates/rairos-research
COPY crates/rairos-parser ./crates/rairos-parser
COPY crates/rairos-memory ./crates/rairos-memory
COPY crates/rairos-mcp ./crates/rairos-mcp
COPY crates/rairos-cli ./crates/rairos-cli
COPY crates/rairos-llm ./crates/rairos-llm

RUN mkdir -p .cargo && \
    echo '[target.x86_64-unknown-linux-gnu]' >> .cargo/config.toml && \
    echo 'linker = "gcc"' >> .cargo/config.toml && \
    echo 'rustflags = "-C target-feature=-crt-static"' >> .cargo/config.toml

RUN cargo build --release -p rairos-web

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    libpq5 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/rairos-web /usr/local/bin/

ENV RAIROS_ADDR=0.0.0.0:8080
ENV RUST_LOG=info

EXPOSE 8080

CMD ["rairos-web"]
